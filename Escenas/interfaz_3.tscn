[sub_resource type="GDScript" id="GDScript_lxc5e"]
script/source = "extends Area2D

func _on_body_entered(body: Node2D) -> void:
	if body is CharacterBody2D:
		# 1. Intentar reproducir la animación
		# Usamos find_child por si el nodo está un poco más oculto en la jerarquía
		var anim = body.find_child(\"AnimatedSprite2D\")
		
		# 2. Congelar al jugador (para que no se mueva mientras muere)
		body.set_physics_process(false)
		
		if anim:
			anim.play(\"Dead\")
		
		# 3. ESPERA DE SEGURIDAD: Espera 1.2 segundos y reinicia 
		# Esto ignora si la animación tiene loop o no
		await get_tree().create_timer(1.2).timeout
		
		# 4. Reiniciar
		get_tree().reload_current_scene()


func _on_cuerpo_dañino_body_entered(body: Node2D) -> void:
	pass # Replace with function body.


func _on_cabeza_detector_body_entered(body: Node2D) -> void:
	pass # Replace with function body.
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_lxc5e"]
size = Vector2(446, 20)

[sub_resource type="GDScript" id="GDScript_dt8o0"]
script/source = "extends CharacterBody2D

const SPEED = 50.0
const GRAVITY = 900.0

var direction = 1
var esta_muerto = false

@onready var anim = $AnimatedSprite2D
@onready var rayo = $RayCast2D

func _physics_process(delta: float) -> void:
	# 1. BLOQUEO DE MUERTE: Si está muerto, no hace nada de lo de abajo
	if esta_muerto:
		return

	# Gravedad básica
	if not is_on_floor():
		velocity.y += GRAVITY * delta
	
	# Patrulla: Si choca pared o no hay suelo, da la vuelta
	if is_on_wall() or not rayo.is_colliding():
		direction *= -1
		rayo.position.x = 15 * direction 
	
	velocity.x = direction * SPEED
	
	# --- CONTROL DE ANIMACIONES DE MOVIMIENTO ---
	if velocity.x != 0:
		anim.play(\"Run\")
		anim.flip_h = direction < 0
	else:
		anim.play(\"Idle\")
		
	move_and_slide()

# --- DETECCIÓN DE JUGADOR (Asegúrate de conectar estas señales) ---

func _on_cabeza_detector_body_entered(body: Node2D) -> void:
	# Prioridad: Solo si cae sobre la cabeza y no está ya muerto
	if not esta_muerto and body.is_in_group(\"jugador\") and body.velocity.y > 0:
		morir(body)

func _on_cuerpo_dañino_body_entered(body: Node2D) -> void:
	if not esta_muerto and body.is_in_group(\"jugador\"):
		# Si el gato tiene la función, que muera con estilo
		if body.has_method(\"morir_gato\"):
			body.morir_gato()
		else:
			# Si el gato no tiene la función, reiniciamos de golpe para no trabarnos
			get_tree().reload_current_scene()
# --- FUNCIÓN DE MUERTE (REVISADA) ---

func morir(jugador_node):
	esta_muerto = true # Esto detiene el movimiento y otras animaciones arriba
	
	# Detenemos al enemigo en seco
	velocity = Vector2.ZERO
	
	# Rebote del jugador
	jugador_node.velocity.y = -400
	
	# REPRODUCIR ANIMACIÓN DE MUERTE
	if anim.sprite_frames.has_animation(\"Hit\"):
		anim.play(\"Hit\")
		print(\"Reproduciendo Hit...\")
	else:
		print(\"ERROR: No existe la animación 'Hit' en el AnimatedSprite2D\")

	# DESACTIVAR COLISIONES (Para que no estorbe mientras muere)
	# Usamos set_deferred por seguridad en Godot
	$CollisionShape2D.set_deferred(\"disabled\", true)
	$CuerpoDañino/CollisionShape2D.set_deferred(\"disabled\", true)
	$CabezaDetector/CollisionShape2D.set_deferred(\"disabled\", true)
	
	# ESPERAR A QUE TERMINE PARA DESAPARECER
	await anim.animation_finished
	queue_free()
"

